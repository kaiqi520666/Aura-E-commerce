# PayPal sandbox/live config
# Copy this file to .env.local and fill in your own values.

FRONTEND_BASE_URL=https://your-store-domain.com
# or use MALL_FRONTEND_BASE_URL if you want a mall-specific name
# MALL_FRONTEND_BASE_URL=https://your-store-domain.com

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
